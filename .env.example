# Django
SECRET_KEY=your-secret-key-here
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather

# Database
# Вариант 1: явный переключатель backend.
DB_BACKEND=sqlite
SQLITE_NAME=db.sqlite3
DB_SQLITE_TIMEOUT_SEC=20
# Для Postgres:
# DB_BACKEND=postgres
# POSTGRES_DB=telegram_bot
# POSTGRES_USER=telegram_bot
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer
# DB_CONN_MAX_AGE=60
#
# Вариант 2: единый URL (имеет приоритет над DB_BACKEND)
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://telegram_bot:change-me@127.0.0.1:5432/telegram_bot

# Redis for Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Bitrix24 — исходящий вебхук (для вызовов API: экспорт контактов и т.д.)
# В Битрикс: Разработчикам → Другое → Исходящий вебхук → URL скопировать сюда
# BITRIX_WEBHOOK_URL=
# Таймаут REST-запросов к Bitrix (сек). При медленном Bitrix24 увеличьте до 60–90.
BITRIX_REQUEST_TIMEOUT_SEC=60
# Адрес контакта из реквизитов (как в карточке «Фактический адрес»)
BITRIX_ADDRESS_USE_REQUISITES=true
# BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxx/
# Секрет для webhook запуска рассылок из Bitrix-роботов:
# /api/bitrix/run-mailing/?secret=...
BITRIX_MAILING_WEBHOOK_SECRET=

# MAX messenger
MAX_BOT_TOKEN=f9LHodD0cOLGsRzg4Q1Fs6BsRXv0zZV2PtUcDj4rkQMujRzThqpCwwQLz5myW7vFNGAEeCXvQ1jwHcQhTcdf
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_WEBHOOK_SECRET=
# Типы событий MAX webhook (через запятую). Для связки группы с Bitrix нужны bot_added,chat_title_changed
MAX_UPDATE_TYPES=message_created,bot_added,chat_title_changed
# MAX web WS token (from __oneme_auth), used for reverse-engineered WS flows
MAX_WS_TOKEN=
# MAX group create webhook/task settings
MAX_GROUP_WEBHOOK_SECRET=
MAX_GROUP_PROFILE_DIR=profile/.max-manual-profile
MAX_GROUP_TOKEN_FILE=profile/max_ws_token.env
MAX_GROUP_REFRESH_TIMEOUT=45
# true: refresh перед каждой задачей создания группы (более шумно, но предсказуемо)
MAX_GROUP_REFRESH_EACH_TASK=false
# true: при auth/token ошибке сделать refresh и один ретрай создания группы
MAX_GROUP_REFRESH_ON_AUTH_FAIL=true
MAX_GROUP_BOT_USER_ID=0
MAX_GROUP_BOT_GRANT_ADMIN=true
# true: если после резолва/исключений user_ids пуст, создать группу с ботом (MAX_GROUP_BOT_USER_ID)
MAX_GROUP_ALLOW_EMPTY_WITH_BOT=false
# Минимальный интервал между webhook-запросами создания групп (секунды), 0 = выключено
MAX_GROUP_MIN_INTERVAL_SEC=0
# Минимальный интервал между запусками Celery-задачи создания групп (сек), 0 = выключено
MAX_GROUP_TASK_MIN_INTERVAL_SEC=60
# Пауза перед добавлением участников в созданный чат
MAX_GROUP_ADD_MEMBERS_DELAY_SEC=15
# true: если user_ids не найдены обычным способом, пробуем phone->user_id через MAX WS (opcode=46)
MAX_GROUP_PHONE_RESOLVE_ENABLED=true
# Таймаут (сек) для одного WS запроса phone->user_id
MAX_GROUP_PHONE_RESOLVE_TIMEOUT_SEC=20
# Интервал (сек) между WS запросами phone->user_id
MAX_GROUP_PHONE_RESOLVE_DELAY_MIN_SEC=10
MAX_GROUP_PHONE_RESOLVE_DELAY_MAX_SEC=20
MAX_GROUP_WELCOME_TEXT=Добро пожаловать! Мы на связи.
MAX_GROUP_WELCOME_DELAY_SEC=60
# Ссылка в конце приветствия (если задан MAX_GROUP_WELCOME_TEXT — отдельное сообщение со ссылкой не шлём)
MAX_GROUP_WELCOME_INCLUDE_INVITE_LINK=true
# Пусто — в конец приветствия добавится « » + ссылка. Или свой шаблон, напр. « {link}»
MAX_GROUP_WELCOME_INVITE_SUFFIX=
# Вложения из папки media/ (| — разделитель)
MAX_GROUP_WELCOME_MEDIA_ENABLED=true
MAX_GROUP_WELCOME_MEDIA_FILES=Гибка профиля.png|Decoplume каталог 2026.pdf|LACONISTIQ & DECOPLUME v3.4 (2026).pdf|Laconistiq каталог 2026.pdf
MAX_GROUP_WELCOME_MEDIA_DELAY_SEC=1.5
# Отдельное сообщение только со ссылкой (если привет пустое или INCLUDE_INVITE_LINK=false)
MAX_GROUP_INVITE_LINK_ENABLED=true
MAX_GROUP_INVITE_LINK_DELAY_SEC=5
MAX_GROUP_INVITE_LINK_TEXT=Ссылка для входа в группу:\n{link}
# Связка группы MAX с контактом Bitrix по номеру в названии (1111 / LACONISTIQ / ...)
MAX_GROUP_BITRIX_SYNC_ENABLED=true
MAX_GROUP_BITRIX_SYNC_EVENTS=bot_added,chat_title_changed
MAX_GROUP_BITRIX_SYNC_TITLE_DELAY_SEC=3
BITRIX_UF_MESSENGER_CHAT_NUMBER=UF_CRM_1742560088
BITRIX_UF_COMPANY_MESSENGER_CHAT_NUMBER=UF_CRM_1779436763
BITRIX_UF_COMPANY_MAX_CHAT_ID=UF_CRM_1779436775
BITRIX_UF_MAX_CHAT_ID=UF_CRM_1774872874
# CSV-список MAX user_id, которые должны быть исключены при создании групп
# (например, чтобы не добавлять проблемный/служебный аккаунт): 123,456
MAX_GROUP_EXCLUDE_USER_IDS=
# Группа из контакта/компании: + N сотрудников из админки (openlines → Сотрудники MAX-группы)
MAX_GROUP_CONTACT_ADD_COMPANY_MEMBERS=true
MAX_GROUP_CONTACT_STAFF_ROSTER_LIMIT=3
MAX_GROUP_STAFF_ROSTER_LIMIT=0
MAX_GROUP_COMPANY_ADD_STAFF_ROSTER=true
MAX_GROUP_COMPANY_STAFF_ROSTER_LIMIT=0
# UF контакта-сотрудника в Bitrix: привязка к user и MAX user_id
BITRIX_UF_EMPLOYEE_BITRIX_USER_ID=
BITRIX_UF_EMPLOYEE_MAX_USER_ID=
BITRIX_UF_USER_MAX_USER_ID=UF_USR_1779878090247
# Публичный https URL картинки для аватарки новых MAX-групп
MAX_GROUP_AVATAR_URL=
# Отправлять ли системное уведомление о смене аватарки
MAX_GROUP_AVATAR_NOTIFY=false
